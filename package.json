{
  "name": "eliejesresce-k2-theme",
  "displayName": "Eliejesresce K2 Themes",
  "description": "A family of five dark and one light VS Code themes designed for clarity, contrast, and long coding sessions.",
  "version": "3.0.0",
  "publisher": "archimango",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdcamargo2/eliejesresce-k2-theme.git"
  },
  "homepage": "https://github.com/jdcamargo2/eliejesresce-k2-theme#readme",
  "bugs": {
    "url": "https://github.com/jdcamargo2/eliejesresce-k2-theme/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "pastel",
    "high contrast",
    "quantum",
    "coding",
    "k2"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "validate": "node scripts/build.js --validate",
    "check:themes": "node scripts/build.js --check",
    "report:contrast": "node scripts/build.js --validate --report-contrast",
    "test": "node --test tests/*.test.js && npm run validate && npm run check:themes && npm run report:diff",
    "report:diff": "node scripts/report-diff.js"
  },
  "contributes": {
    "themes": [
      {
        "label": "Coherence",
        "uiTheme": "vs-dark",
        "path": "./themes/k2-coherence.json"
      },
      {
        "label": "Vacuum",
        "uiTheme": "vs-dark",
        "path": "./themes/k2-vacuum.json"
      },
      {
        "label": "Dim",
        "uiTheme": "vs-dark",
        "path": "./themes/k2-dim.json"
      },
      {
        "label": "Endurance",
        "uiTheme": "vs-dark",
        "path": "./themes/k2-endurance.json"
      },
      {
        "label": "Ferro",
        "uiTheme": "vs-dark",
        "path": "./themes/k2-ferro.json"
      },
      {
        "label": "Ash",
        "uiTheme": "vs",
        "path": "./themes/k2-ash.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
