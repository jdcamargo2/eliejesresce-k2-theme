  "tokenColors": [
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.struct",
        "storage.type.enum",
        "storage.type.trait",
        "storage.type.union",
        "storage.type.record"
      ],
      "settings": {
        "foreground": "#7585F9"
      }
    },
    {
      "name": "Modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B6AD2A"
      }
    },
    {
      "name": "Imports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.other.package.java",
        "keyword.control.import.java",
        "keyword.control.directive.include.c",
        "keyword.control.directive.include.cpp",
        "meta.preprocessor.include.cpp punctuation.definition.directive.cpp",
        "string.quoted.other.lt-gt.include.c",
        "string.quoted.double.include.c"
      ],
      "settings": {
        "foreground": "#0897C7"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive.c",
        "keyword.control.directive.define.c",
        "keyword.control.directive.define.cpp",
        "punctuation.definition.directive.c"
      ],
      "settings": {
        "foreground": "#0DA88D"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.enum",
        "support.type",
        "support.class",
        "storage.type.primitive.java",
        "storage.type.built-in.c",
        "storage.type.built-in.primitive.c",
        "storage.type.built-in.primitive.cpp",
        "storage.type.numeric.rust",
        "storage.type.primitive.rust",
        "support.type.primitive.ts",
        "support.type.primitive.tsx",
        "support.type.builtin.ts",
        "support.type.builtin.tsx",
        "support.type.exception.python",
        "entity.name.type.exception.python"
      ],
      "settings": {
        "foreground": "#FF5263"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "entity.name.function.magic.python",
        "entity.name.function.constructor.java"
      ],
      "settings": {
        "foreground": "#C25CFF"
      }
    },
    {
      "name": "Macros and enum members",
      "scope": [
        "entity.name.function.macro.rust",
        "support.macro.rust",
        "entity.name.constant",
        "variable.other.enummember",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#37D9B2"
      }
    },
    {
      "name": "Variables and properties",
      "scope": [
        "variable",
        "variable.other.constant",
        "support.variable",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "meta.mapping.key.yaml string.unquoted.plain.out.yaml",
        "meta.mapping.key.yaml string.unquoted.plain.in.yaml",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#CFD5DA"
      }
    },
    {
      "name": "Parameters and receivers",
      "scope": [
        "variable.parameter",
        "variable.language.special.self.python",
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.function.language.special.cls.python",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#FF9638"
      }
    },
    {
      "name": "Strings and regex",
      "scope": [
        "string",
        "string.regexp",
        "meta.mapping.value.yaml string.unquoted.plain.out.yaml",
        "meta.mapping.value.yaml string.unquoted.plain.in.yaml"
      ],
      "settings": {
        "foreground": "#58C5F2"
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#A9E84C"
      }
    },
    {
      "name": "Absence",
      "scope": [
        "constant.language.null",
        "constant.language.nullptr"
      ],
      "settings": {
        "foreground": "#FFE84B"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "storage.type.annotation",
        "entity.name.type.annotation.java"
      ],
      "settings": {
        "foreground": "#F16BA9"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.parameters",
        "punctuation.definition.typeparameters",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ADB6BE"
      }
    },
    {
      "name": "Comments and documentation",
      "scope": [
        "string.quoted.docstring.multi.python",
        "string.quoted.docstring.single.python",
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#A6B2BD"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FF5263"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#CFD5DA",
    "variable.readonly": "#CFD5DA",
    "variable.defaultLibrary": "#CFD5DA",
    "property": "#CFD5DA",
    "property.readonly": "#CFD5DA",
    "parameter": "#FF9638",
    "class": "#FF5263",
    "interface": "#FF5263",
    "struct": "#FF5263",
    "type": "#FF5263",
    "typeParameter": "#FF5263",
    "enum": "#FF5263",
    "function": "#C25CFF",
    "method": "#C25CFF",
    "macro": "#37D9B2",
    "enumMember": "#37D9B2",
    "decorator": "#F16BA9",
    "keyword": "#7585F9",
    "regexp": "#58C5F2",
    "string": "#58C5F2",
    "number": "#A9E84C",
    "comment": "#A6B2BD",
    "operator": "#ADB6BE",
    "namespace": "#CFD5DA"
  }
}
