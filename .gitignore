cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Packaged extensions
*.vsix

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
.nyc_output/

# Temporary build output
dist/
build/
out/
tmp/
temp/
.cache/

# VS Code test downloads
.vscode-test/
.vscode-test-web/

# Environment files
.env
.env.*
!.env.example

# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
*.swp
*.swo
*~

# Python caches, in case fixtures generate them
__pycache__/
*.py[cod]

# Local screenshots or scratch files
screenshots-local/
EOF